{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?__proxy_target=api&__proxy_path=:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/proxy?__proxy_target=uploads&__proxy_path=:path*"
    },
    {
      "source": "/((?!api(?:/|$)|uploads(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
